#!/usr/bin/env bash
# Allow pushes only to <type>/<kebab-name> branches; main changes go through pull requests.
set -euo pipefail

valid_branch='^(feat|fix|chore|docs|refactor|test|ci|perf|release)/[a-z0-9]+(-[a-z0-9]+)*$'
empty_sha='0000000000000000000000000000000000000000'

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [[ "$local_sha" == "$empty_sha" ]] && continue
  branch="${remote_ref#refs/heads/}"
  if [[ "$branch" == "main" ]]; then
    echo "pre-push: open a pull request instead of pushing to main." >&2
    exit 1
  fi
  if [[ "$remote_ref" == refs/heads/* && ! "$branch" =~ $valid_branch ]]; then
    echo "pre-push: rename '$branch' to <type>/<kebab-case-name>." >&2
    exit 1
  fi
done
