#!/usr/bin/env bash
# Refuse commit messages with co-author trailers or with phrases listed in the
# untracked file .git/info/blocked-phrases (one extended regex per line).
set -euo pipefail

message="$1"
blocked="$(git rev-parse --git-dir)/info/blocked-phrases"

if grep -qiE '^[[:space:]]*co-authored-by:' "$message"; then
  echo "commit-msg: remove the co-author trailer." >&2
  exit 1
fi
if [[ -s "$blocked" ]]; then
  patterns="$(grep -vE '^[[:space:]]*(#|$)' "$blocked" || true)"
  if [[ -n "$patterns" ]] && grep -qiE -f <(printf '%s\n' "$patterns") "$message"; then
    echo "commit-msg: the message matches a blocked phrase." >&2
    exit 1
  fi
fi
